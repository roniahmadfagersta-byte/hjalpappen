# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/marknadsplats?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_REFRESH_EXPIRATION="30d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# SMS (Twilio or 46elks for Swedish numbers)
SMS_PROVIDER="46elks"
SMS_API_KEY="your-sms-api-key"
SMS_API_SECRET="your-sms-api-secret"
SMS_FROM_NUMBER="+46701234567"

# App
PORT=3000
NODE_ENV="development"
APP_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# Payment (Stripe / Swish)
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
SWISH_CERTIFICATE_PATH="./certs/swish.pem"
SWISH_CA_PATH="./certs/swish-ca.pem"
SWISH_PAYEE_ALIAS="1234567890"

# Commission
PLATFORM_COMMISSION_RATE="0.10"

# AI / OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4"

# Redis (for rate limiting, caching, WebSocket adapter)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# File uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="10485760"

# Geocoding
GEOCODING_API_KEY="your-google-maps-api-key"

# Email (for password reset etc.)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="noreply@marknadsplats.se"

# 2FA
TWO_FA_APP_NAME="Marknadsplats"
